# Copy this file to .env and edit values as needed.

# Shared app settings
APP_NAME=AI Exam Prep API
APP_VERSION=1.1.0

# Use JSON array syntax for multiple origins.
ALLOW_ORIGINS=["*"]

# AI layer
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
EMBED_MODEL=text-embedding-3-small

# Backend + infra (must match docker-compose.yml)
DATABASE_URL=postgresql://assitify:assitify123@localhost:5432/assitify
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
AI_LAYER_URL=http://127.0.0.1:8000
JWT_SECRET=change-me-in-production-assitify
AUTH_REQUIRED=false
FRONTEND_URL=http://localhost:5173
